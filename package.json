{
  "name": "workedo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start:dev": "cross-env APP_ENV=development EXPO_PUBLIC_APP_ENV=development npx expo run:android",
    "start:prod": "cross-env APP_ENV=production EXPO_PUBLIC_APP_ENV=production npx expo run:android",
    "android:dev": "cross-env APP_ENV=development EXPO_PUBLIC_APP_ENV=development expo start --android",
    "android:prod": "cross-env APP_ENV=production EXPO_PUBLIC_APP_ENV=production expo start --android",
    "build:apk:dev": "cross-env APP_ENV=development EXPO_PUBLIC_APP_ENV=development npm run build:android:release",
    "build:apk:prod": "cross-env APP_ENV=production EXPO_PUBLIC_APP_ENV=production npm run build:android:release",
    "build:android:release": "cd android && gradlew assembleRelease",
    "watch": "expo start --android --clear"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.4.0",
    "@shopify/flash-list": "2.0.2",
    "axios": "^1.17.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "expo": "~56.0.9",
    "expo-camera": "~56.0.7",
    "expo-constants": "~56.0.17",
    "expo-font": "~56.0.5",
    "expo-image": "~56.0.10",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-notifications": "^56.0.16",
    "expo-router": "~56.2.9",
    "expo-screen-orientation": "~56.0.5",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "hammerjs": "^2.0.8",
    "jotai": "^2.20.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-native": "0.85.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-country-select": "0.3.5",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-pager-view": "8.0.1",
    "react-native-popover-view": "^6.1.0",
    "react-native-reanimated": "4.3.1",
